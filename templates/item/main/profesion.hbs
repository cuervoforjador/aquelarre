<div class="_main {{#if isEditable}}_editable{{/if}}">
    <div class="_sheetContent">

        {{!-- PROPERTIES --}}
        <div class="_properties">
            <input type="text" 
                class="_italic"
                style="width: 100%;"
                {{{_disabled}}}
                name="system.resumen" 
                value="{{system.resumen}}">
            <div class="_row _gapped _menu">
                {{{navTab 'primary' (array 'caracteristicas' 'competencias' 'descripcion') '_expanded'}}}
            </div>                                     
        </div>

        {{>tab_ProfesionesCaracteristicas}}
        {{>tab_ProfesionesCompetencias}}
        {{>tab_Descripcion}}

    </div>
    <div class="_sheetFooter">
        {{>item_footer}}
    </div>    
</div>