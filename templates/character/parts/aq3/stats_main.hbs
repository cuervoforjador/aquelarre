<div class="_stats">
    <div class="_left">
        <h4 class="_title divider">{{localize 'common.caracteristicas'}}</h4>
        <div class="_row">

            <!-- CARACTERÍSTICAS -->
            <div class="_chars">
                {{>stats_chars_aq3}}
                {{>stats_extra_aq3}}
            </div>
            <!-- ATRIBUTOS -->
            <div class="_attrs">
                {{>stats_health_aq3}}
                {{>stats_rrirr_aq3}}
            </div>

        </div>
    </div>
    <div class="_right">
        <div class="_logo"></div>

        <!-- PUNTOS DE APRENDIZAJE -->
        <label class="_subTitle _pta">{{localize 'ATTR.pta'}}</label>
        <input type="number" 
                class="_stat _center _pta"
                {{{_disabled}}}
                name="system.atributos.pta.value" 
                value="{{system.atributos.pta.value}}" 
                min="0" 
                max="666">  
    </div>
</div>