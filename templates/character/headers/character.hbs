<div class="_header _sheetHeader">

    {{>character_background}}
    <div class="_mainHeader">

        <div class="portrait" >
            <img src="{{actor.img}}" 
                    data-edit="img"
                    title="{{actor.name}}"
                    alt="{{actor.name}}"
                    {{#if isEditable}} data-action="editImage" {{/if}}
                    class="actor-portrait">
        </div>
        <div class="_info">

            <input type="text" 
                    class="h4"
                    name="name" 
                    value="{{actor.name}}" 
                    {{{_disabled}}}
                    placeholder="{{localize 'common.nombre'}}"> 
            <div class="_row _gapped _marginTop">              
                <div class="_combo">
                    <label>{{localize 'common.rules'}} :</label>
                    <select name="system.rules" {{{_disabled}}} style="width: calc(var(--fSize) * 10);">
                    {{selectOptions rules 
                                    selected=system.rules
                                    localize=false
                                    nameAttr="key"
                                    labelAttr="label" }}
                    </select>                 
                </div>
                <div class="_combo">
                    <label>{{localize 'common.reino'}} :</label>
                    {{#if isEditable}}
                        <select name="info.reino.key" {{{_disabled}}}>
                        {{selectOptions lore.reinos 
                                        selected=info.reino.key
                                        localize=false
                                        nameAttr="key"
                                        labelAttr="label" }}
                        </select>   
                    {{else}}
                        <img class="_fieldImg" src="{{info.reino.img}}" />
                        <label class="_field">{{info.reino.label}}</label>
                    {{/if}}            
                </div>                                      
            </div>            
            <div class="_row _gapped _marginTop">
                {{{navTab 'primary' (array 'stats' 'combat') '_expanded'}}}
            </div>
            
        </div>
    </div>
</div>